# Leave all three empty for local development: requests go to /api (Vite proxies them to
# http://localhost:8000) and sign-in uses the Python backend.
#
# For the AWS build, set them (the GitHub Actions workflow does this from repository variables):
#   VITE_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com
#   VITE_COGNITO_USER_POOL_ID=us-east-1_AbCdEfGhI
#   VITE_COGNITO_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
